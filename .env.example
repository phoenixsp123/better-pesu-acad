# Better PESU Acad — Environment Configuration Template
# Copy this file to .env and fill in your details if using automated sync.
# Credentials are stored locally on your machine and never transmitted to third parties.

# PESU Academy Credentials (Optional - can also be configured inside the Desktop App)
PESU_USER=your_srn_or_prn
PESU_PASS=your_password

# Custom Data Directory (Optional - defaults to OS standard Application Support / AppData)
# BETTERPESU_DATA_DIR=/path/to/custom/data
